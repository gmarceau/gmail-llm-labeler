#!/bin/zsh
set -euo pipefail

SCRIPT_DIR="${0:A:h}"
PROJECT_ROOT="${SCRIPT_DIR:h}"
VENV_PYTHON="$PROJECT_ROOT/venv/bin/python"
CONFIG_FILE="config_production_7b.yaml"

if [[ ! -f "$VENV_PYTHON" ]]; then
    echo "Error: Virtual environment not found at $VENV_PYTHON" >&2
    echo "Run: cd $PROJECT_ROOT && python3 -m venv venv && pip install -e ." >&2
    exit 1
fi

if [[ ! -f "$PROJECT_ROOT/$CONFIG_FILE" ]]; then
    echo "Error: Config file not found: $PROJECT_ROOT/$CONFIG_FILE" >&2
    exit 1
fi

cd "$PROJECT_ROOT" || {
    echo "Error: Cannot change to project directory: $PROJECT_ROOT" >&2
    exit 1
}

# Scheduled runs (Shortcuts automations) capture no output, so a run that
# dies mid-flight leaves nothing to diagnose. Capture the full stdout+stderr
# per run; -u keeps python unbuffered so a SIGKILL can't swallow the tail.
# Keep 14 days of run logs.
LOG_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/gmail-llm-labeler/logs"
LOG_FILE="$LOG_DIR/pipeline-$(date +%Y%m%d-%H%M%S).log"
mkdir -p "$LOG_DIR"
find "$LOG_DIR" -name 'pipeline-*.log' -mtime +14 -delete

echo "=== pipeline run $(date '+%Y-%m-%d %H:%M:%S') config=$CONFIG_FILE ===" >> "$LOG_FILE"
exec "$VENV_PYTHON" -u -m email_labeler.pipeline.cli run --config "$CONFIG_FILE" >> "$LOG_FILE" 2>&1
